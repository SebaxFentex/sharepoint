# Configuracion LOCAL para los entrypoints de este repo (tests, login).
# Copiar a `.env` (ignorado por git) y ajustar. La libreria NO lee este
# archivo: solo recibe parametros explicitos. Otro proyecto que importe
# `sharepoint` usa su propio `.env` y pasa los valores a ClienteSharepoint.
#
# Uso: uv run --env-file .env python tests/test_*.py
#
# Los valores de ejemplo son placeholders: reemplazar con los reales.


# Correo para validar contexto de sesion en la UI (requerido).
SHAREPOINT_CORREO_USUARIO=usuario@empresa.com

# Pagina para validar sesion al arrancar, login y ClienteSharepoint (requerido).
SHAREPOINT_URL_INICIO=https://empresa.sharepoint.com/sites/SITIO/Pages/Home.aspx

# Carpeta destino de los tests e2e, subida/descarga (requerido).
SHAREPOINT_URL_CARPETA_PRUEBAS=https://empresa.sharepoint.com/sites/SITIO/Documentos%20compartidos/CarpetaPruebas

# Vinculo compartido (?d=...) del archivo a descargar
# (Compartir > Copiar vinculo), para test_descargar_archivo.py (requerido).
SHAREPOINT_URL_ARCHIVO_COMPARTIDO=PEGA_AQUI_EL_VINCULO_COMPARTIDO


# Carpeta del perfil de navegador (opcional). Si no se define, usa
# %LOCALAPPDATA%/perfil_playwright_sharepoint.
# Ejemplo: SHAREPOINT_CARPETA_PERFIL=C:/ruta/al/perfil

# Nivel de log: DEBUG, INFO, WARNING, ERROR (opcional, default INFO).
SHAREPOINT_NIVEL_LOG=INFO