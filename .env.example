# Configuracion LOCAL para los entrypoints de este repo (tests, login).
# Copiar a `.env` (ignorado por git) y ajustar. La libreria NO lee este
# archivo: solo recibe parametros explicitos. Otro proyecto que importe
# `ms365` usa su propio `.env` y pasa los valores a SharepointClient.
#
# Uso: uv run --env-file .env -- python tests/test_upload_files.py
#
# Los valores de ejemplo son placeholders: reemplazar con los reales.
# Nada de este archivo debe contener datos de un tenant o usuario real.

# Usuario para validar contexto de sesion en la UI (requerido).
MS365_USER_EMAIL=usuario@empresa.com

# true = sin ventana (scheduler); false = headed (debug local, opcional).
MS365_HEADLESS=false

# Pagina para validar sesion al arrancar, login y SharepointClient (requerido).
MS365_HOME_URL=https://empresa.sharepoint.com/sites/SITIO/Pages/Home.aspx

# Carpeta destino de los tests e2e, upload/download (requerido).
MS365_TEST_FOLDER_URL=https://empresa.sharepoint.com/sites/SITIO/Documentos%20compartidos/CarpetaPruebas

# Vinculo compartido (?d=...) del archivo a descargar
# (Compartir > Copiar vinculo), para test_download_single_file.py (requerido).
MS365_TEST_SHARED_FILE_URL=PEGA_AQUI_EL_VINCULO_COMPARTIDO

# Nivel de log: DEBUG, INFO, WARNING, ERROR (opcional, default INFO).
MS365_LOG_LEVEL=INFO

# Prefijo de los archivos de log en %LOCALAPPDATA%/programas_python/ms365/logs
# (opcional, default ms365-). Solo para los entrypoints de este repo.
MS365_LOG_FILE_PREFIX=ms365-

# Cuantos .log recientes conservar (opcional, default 30, purga automatica).
MS365_MAX_LOG_FILES=30
